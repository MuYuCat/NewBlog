---
// Footer.astro - 极简极客版
import dayjs from 'dayjs';

const currentYear = dayjs().year();
const copyrightYear = currentYear > 2026 ? `2026 - ${currentYear}` : '2026';
---
<footer class="main-footer">
  <div class="footer-container">
    <div class="footer-content">
      <!-- 左侧：版权 -->
      <div class="footer-left">
        <span class="copyright">© {copyrightYear} MuYuCat</span>
      </div>

      <!-- 中间：技术支持 -->
      <div class="footer-center">
        <div class="powered-by">
          <span class="prefix">Powered by</span>
          <a href="https://astro.build" target="_blank" class="link">Astro</a>
          <span class="amp">&</span>
          <a href="https://vueuse.org/" target="_blank" class="link geek-link">
            Vue
            <svg class="geek-icon" viewBox="0 0 24 24" width="16" height="16" fill="none" xmlns="http://www.w3.org/2000/svg">
              <path d="M12 2L15 9L22 12L15 15L12 22L9 15L2 12L9 9L12 2Z" fill="currentColor" fill-opacity="0.5"></path>
              <path d="M12 6L13.5 9.5L17 11L13.5 12.5L12 16L10.5 12.5L7 11L10.5 9.5L12 6Z" fill="currentColor"></path>
            </svg>
          </a>
        </div>
      </div>

      <!-- 右侧：社交与订阅 -->
      <div class="footer-right">
        <!-- RSS -->
        <a href="/feed.xml" aria-label="RSS Feed" class="control-btn">
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M4 11a9 9 0 0 1 9 9"></path>
            <path d="M4 4a16 16 0 0 1 16 16"></path>
            <circle cx="5" cy="19" r="1"></circle>
          </svg>
        </a>
        <!-- GitHub -->
        <a href="/about" aria-label="GitHub" class="control-btn">
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.28 1.15-.28 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"></path><path d="M9 18c-4.51 2-5-2-7-2"></path></svg>
        </a>
        <!-- Telegram -->
        <a href="/about" aria-label="Telegram" class="control-btn">
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"><line x1="22" y1="2" x2="11" y2="13"></line><polygon points="22 2 15 22 11 13 2 9 22 2"></polygon></svg>
        </a>
        <!-- Email -->
        <a href="/about" aria-label="Email" class="control-btn">
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"><rect width="20" height="16" x="2" y="4" rx="2"></rect><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"></path></svg>
        </a>
      </div>
    </div>
  </div>
</footer>

<style lang="scss">
.main-footer {
  width: 100%;
  background: var(--bg);
  border-top: 1px solid var(--border);
  padding: 2.5rem 0;
  transition: background 0.3s, border-color 0.3s;

  .footer-container {
    width: 100%;
    display: flex;
    justify-content: center;
  }

  .footer-content {
    width: 100%;
    max-width: 1300px;
    padding: 0 2rem;
    display: flex;
    justify-content: space-between;
    align-items: center;
    box-sizing: border-box;

    .footer-left {
      display: flex;
      flex-direction: column;
      gap: 0.8rem;

      .footer-logo-wrapper {
        display: flex;
        align-items: center;
        gap: 0.6rem;
        text-decoration: none;
        opacity: 0.9;

        .footer-logo-img {
          width: 24px;
          height: 24px;
          object-fit: contain;
        }

        .footer-logo-text {
          font-family: var(--heading);
          font-size: 1.2rem;
          font-weight: 500;
          font-style: italic;
          color: var(--text-h);
        }

        .dark-only { display: none; }
        :global(.dark) & {
          .light-only { display: none; }
          .dark-only { display: block; }
        }
      }

      .copyright {
        font-family: var(--sans);
        font-size: 0.75rem;
        color: var(--text);
        opacity: 0.5;
        font-weight: 400;
        letter-spacing: 0.05em;
      }
    }

    .footer-center {
      .powered-by {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        font-size: 0.8125rem;
        color: var(--text);
        opacity: 0.5;

        .link {
          color: var(--text-h);
          text-decoration: none;
          font-weight: 600;
          transition: opacity 0.2s;
          &:hover { opacity: 0.8; }
        }

        .geek-link {
          display: flex;
          align-items: center;
          gap: 4px;
          color: var(--accent);
        }

        .amp {
          font-style: italic;
          font-family: serif;
        }
      }
    }

    .footer-right {
      display: flex;
      align-items: center;
      gap: 1rem;

      .control-btn {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 36px;
        height: 36px;
        border-radius: 10px;
        color: var(--text);
        opacity: 0.6;
        transition: all 0.3s cubic-bezier(0.25, 1, 0.5, 1);
        
        &:hover {
          background: var(--border);
          opacity: 1;
          color: var(--text-h);
          transform: translateY(-2px);
        }

        svg {
          width: 18px;
          height: 18px;
        }
      }
    }
  }
}

// 移动端简单处理（虽然项目是 Desktop Only，但为了防止容器溢出，做个基础折叠）
@media (max-width: 768px) {
  .footer-content {
    flex-direction: column;
    gap: 1.5rem;
    text-align: center;
  }
}
</style>
