---
import Layout from '../layouts/Layout.astro';
import { Image } from 'astro:assets';
import errorImage from '../assets/404.png';
---

<Layout title="404 - Not Found">
  <main class="error-container">
    <div class="content-wrapper">
      
      <div class="image-section" data-aos="fade-up">
        <Image src={errorImage} alt="404 Illustration" class="error-img" />
      </div>
      <div class="text-section">
        <h1 class="error-title">404</h1>
        <p class="error-slogan">
          糟糕，MuYuCat把这里的路径抓成了一团乱糟糟的毛线。<br/>
          看来线索已经滚远了，我们要不先回首页坐坐？
        </p>
        
        <div class="action-section">
          <a href="/" class="home-button">
            <span>回到温暖的首页</span>
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="icon">
              <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path>
              <polyline points="9 22 9 12 15 12 15 22"></polyline>
            </svg>
          </a>
        </div>
      </div>
    </div>
    
    <div class="background-decor">
      <div class="circle circle-1"></div>
      <div class="circle circle-2"></div>
    </div>
  </main>
</Layout>

<style>
  .error-container {
    height: 100vh;
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--bg);
    position: relative;
    overflow: hidden;
    padding: 2rem;
  }

  .content-wrapper {
    position: relative;
    z-index: 10;
    max-width: 1200px;
    width: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 3rem;
  }

  .image-section {
    width: 100%;
    max-width: 500px;
    filter: drop-shadow(0 20px 50px rgba(0,0,0,0.1));
    transition: transform 0.6s cubic-bezier(0.34, 1.56, 0.64, 1);
  }

  .image-section:hover {
    transform: translateY(-10px) scale(1.02);
  }

  .error-img {
    width: 100%;
    height: auto;
    object-fit: contain;
  }

  .text-section {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    align-items: center;
  }

  .error-title {
    font-family: var(--heading);
    font-size: clamp(6rem, 15vw, 10rem);
    line-height: 1;
    margin: 0;
    font-weight: 700;
    color: var(--text-h);
    letter-spacing: -0.05em;
    background: linear-gradient(to bottom, var(--text-h), var(--text));
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    opacity: 0.9;
  }

  .error-slogan {
    font-family: var(--sans);
    font-size: clamp(1.1rem, 2vw, 1.4rem);
    color: var(--text);
    max-width: 700px;
    line-height: 1.6;
    margin: 0;
    font-weight: 400;
  }

  .action-section {
    margin-top: 1rem;
  }

  .home-button {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 1rem 2.5rem;
    background: var(--text-h);
    color: var(--bg);
    text-decoration: none;
    border-radius: 100px;
    font-family: var(--sans);
    font-weight: 500;
    font-size: 1.1rem;
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    box-shadow: 0 10px 30px -10px rgba(0,0,0,0.3);
  }

  .home-button:hover {
    transform: translateY(-2px);
    box-shadow: 0 20px 40px -15px rgba(0,0,0,0.4);
    filter: brightness(1.1);
  }

  .home-button:active {
    transform: translateY(1px);
  }

  /* Decorative Background Elements */
  .background-decor {
    position: absolute;
    inset: 0;
    pointer-events: none;
    z-index: 1;
  }

  .circle {
    position: absolute;
    border-radius: 50%;
    filter: blur(80px);
    opacity: 0.1;
  }

  .circle-1 {
    width: 40vw;
    height: 40vw;
    background: var(--accent);
    top: -10vw;
    right: -10vw;
  }

  .circle-2 {
    width: 30vw;
    height: 30vw;
    background: var(--accent);
    bottom: -5vw;
    left: -10vw;
  }

  @media (max-width: 768px) {
    .error-container {
      padding: 1rem;
    }
    
    .content-wrapper {
      gap: 2rem;
    }

    .error-title {
      font-size: 5rem;
    }
  }

  /* Dark mode specific adjustments */
  :global(.dark) .home-button {
    background: var(--accent);
    color: var(--bg);
  }

  :global(.dark) .circle {
    opacity: 0.05;
  }
</style>
