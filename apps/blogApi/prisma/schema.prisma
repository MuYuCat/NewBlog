generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id                 Int        @id @default(autoincrement())
  username           String     @unique
  password           String
  email              String?    @unique
  avatar             String?
  role               String     @default("USER")
  status             Int        @default(1)
  twoFactorSecret    String?    // TOTP 密钥
  isTwoFactorEnabled Boolean    @default(false) // 是否启用 2FA
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt
  bookmarks          Bookmark[]
  docs               Doc[]
  articles           Article[]
  media              Media[]
}

model Game {
  id         Int       @id @default(autoincrement())
  platform   String
  platformId String
  title      String
  coverUrl   String?
  playTime   Int       @default(0)
  achieved   Int       @default(0)
  total      Int       @default(0)
  lastPlayed DateTime?
  syncAt     DateTime  @default(now())

  @@unique([platform, platformId])
}

model Doc {
  id        Int      @id @default(autoincrement())
  title     String
  content   String   @db.LongText
  summary   String?  @db.Text
  parentId  Int?
  authorId  Int
  status    Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  author    User     @relation(fields: [authorId], references: [id])
  parent    Doc?     @relation("DocTree", fields: [parentId], references: [id])
  children  Doc[]    @relation("DocTree")

  @@index([authorId], map: "Doc_authorId_fkey")
  @@index([parentId], map: "Doc_parentId_fkey")
}

model Category {
  id        Int       @id @default(autoincrement())
  name      String    @unique
  slug      String    @unique
  order     Int       @default(0)
  articles  Article[] @relation("ArticleCategories")
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Article {
  id          Int      @id @default(autoincrement())
  title       String?  // 碎碎念可无标题
  content     String   @db.LongText // HTML 内容
  jsonContent Json?    // TipTap 结构化 JSON 内容
  summary     String?  @db.Text
  coverUrl    String?
  mood        String?  // 仅 JOURNAL 使用
  location    String?  // 仅 JOURNAL 使用
  clicks      Int      @default(0)
  status      Int      @default(1) // 0:草稿, 1:发布, 2:私密
  
  authorId    Int
  author      User     @relation(fields: [authorId], references: [id])
  
  categories  Category[] @relation("ArticleCategories")
  
  tags        Tag[]    @relation("ArticleTags")
  media       Media[]
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([authorId])
}

model Media {
  id        Int      @id @default(autoincrement())
  fileName  String
  fileType  String   // image/webp, image/jpeg, etc.
  size      Int      // 字节大小
  url       String   @unique // 访问 URL
  path      String   // 物理路径
  
  articleId Int?     // 归属于哪篇文章
  article   Article? @relation(fields: [articleId], references: [id], onDelete: SetNull)
  
  userId    Int
  user      User     @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())

  @@index([articleId])
  @@index([userId])
}

model Tag {
  id        Int        @id @default(autoincrement())
  name      String     @unique
  color     String?    // 预设颜色值
  bookmarks Bookmark[] @relation("BookmarkTags")
  articles  Article[]  @relation("ArticleTags")
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

model Bookmark {
  id          Int      @id @default(autoincrement())
  url         String   @unique
  title       String
  description String?  @db.Text
  coverUrl    String?
  userId      Int
  clicks      Int      @default(0) // 点击量/热度
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id])
  tags        Tag[]    @relation("BookmarkTags")

  @@index([userId], map: "Bookmark_userId_fkey")
}

model Menu {
  id        Int      @id @default(autoincrement())
  name      String   // 菜单显示名称
  path      String   // 路由路径或外部 URL
  icon      String?  // 图标标识符
  i18nKey   String?  // 国际化 Key
  order     Int      @default(0) // 排序
  status    Int      @default(1) // 1: 启用, 0: 禁用
  parentId  Int?     // 父级 ID
  type      Int      @default(1) // 1: 内部路由, 2: 外部链接
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  parent    Menu?    @relation("MenuTree", fields: [parentId], references: [id], onDelete: Cascade)
  children  Menu[]   @relation("MenuTree")

  @@index([parentId])
}

model AuditLog {
  id         Int      @id @default(autoincrement())
  logType    String   @default("API") // PAGE_WEB, PAGE_ADMIN, API
  method     String   // GET, POST, etc.
  path       String   // 请求路径
  status     Int      // 响应状态码
  ip         String   // 访问者 IP
  location   String?  // 地理位置
  duration   Int      // 耗时 (ms)
  userAgent  String?  @db.Text
  body       Json?    // 请求体
  query      Json?    // 查询参数
  userId     Int?     // 操作人 ID (可选)
  createdAt  DateTime @default(now())

  @@index([logType])
  @@index([path])
  @@index([createdAt])
  @@index([userId])
}
