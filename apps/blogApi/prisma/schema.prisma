generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id                 Int        @id @default(autoincrement())
  username           String     @unique
  password           String
  email              String?    @unique
  avatar             String?
  role               String     @default("USER")
  status             Int        @default(1)
  twoFactorSecret    String?    // TOTP 密钥
  isTwoFactorEnabled Boolean    @default(false) // 是否启用 2FA
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt
  bookmarks          Bookmark[]
  docs               Doc[]
}

model Game {
  id         Int       @id @default(autoincrement())
  platform   String
  platformId String
  title      String
  coverUrl   String?
  playTime   Int       @default(0)
  achieved   Int       @default(0)
  total      Int       @default(0)
  lastPlayed DateTime?
  syncAt     DateTime  @default(now())

  @@unique([platform, platformId])
}

model Doc {
  id        Int      @id @default(autoincrement())
  title     String
  content   String   @db.LongText
  summary   String?  @db.Text
  parentId  Int?
  authorId  Int
  status    Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  author    User     @relation(fields: [authorId], references: [id])
  parent    Doc?     @relation("DocTree", fields: [parentId], references: [id])
  children  Doc[]    @relation("DocTree")

  @@index([authorId], map: "Doc_authorId_fkey")
  @@index([parentId], map: "Doc_parentId_fkey")
}

model Bookmark {
  id          Int      @id @default(autoincrement())
  url         String   @unique
  title       String
  description String?  @db.Text
  coverUrl    String?
  categoryId  Int?
  userId      Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id])

  @@index([userId], map: "Bookmark_userId_fkey")
}
