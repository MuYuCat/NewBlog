generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id                 Int        @id @default(autoincrement())
  username           String     @unique
  password           String
  email              String?    @unique
  avatar             String?
  role               String     @default("USER")
  status             Int        @default(1)
  twoFactorSecret    String?    
  isTwoFactorEnabled Boolean    @default(false)
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt
  bookmarks          Bookmark[]
  docs               Doc[]
  articles           Article[]
  media              Media[]
}

// --- 游戏轨迹核心模型 ---

// Master Game: 跨平台聚合的主实体
model Game {
  id          Int      @id @default(autoincrement())
  title       String   // 统一显示标题
  igdbId      String?  @unique // IGDB 唯一标识，用于跨平台自动匹配
  summary     String?  @db.Text
  coverUrl    String?  // 高清封面
  rating      Float?   // 个人评分
  review      String?  @db.LongText // 深度评测协议
  
  platforms   GamePlatform[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// Game Platform: 具体的游玩平台实体
model GamePlatform {
  id          Int      @id @default(autoincrement())
  gameId      Int
  platform    String   // PS5, Steam, Switch, PC
  externalId  String   // 平台方 ID (如 NPWR, AppID)
  playTime    Int      @default(0) // 累计时长 (分钟)
  progress    Int      @default(0) // 进度 (0-100)
  status      Int      @default(1) // 1:想玩, 2:在玩, 3:通关, 4:白金/全成就, 5:搁置
  lastPlayed  DateTime?
  syncAt      DateTime @default(now())

  game        Game     @relation(fields: [gameId], references: [id], onDelete: Cascade)
  achievements GameAchievement[]

  @@unique([platform, externalId])
  @@index([gameId])
}

// Game Achievement: 成就/奖杯详情
model GameAchievement {
  id          Int      @id @default(autoincrement())
  platformId  Int
  name        String
  description String?  @db.Text
  image       String?
  rarity      String?  // Platinum, Gold, Silver, Bronze
  isEarned    Boolean  @default(false)
  earnedAt    DateTime?

  platform    GamePlatform @relation(fields: [platformId], references: [id], onDelete: Cascade)
  @@index([platformId])
}

// Game Sync Config: 敏感同步配置与健康状态
model GameSyncConfig {
  id          Int      @id @default(autoincrement())
  platform    String   @unique // Steam, PSN, GLOBAL_SYNC_STATE
  config      Json?    // 平台特有配置
  lastSyncAt  DateTime?
  status      Int      @default(1) // 1: 健康, 0: 异常, 2: 同步中, 3: 风险警告
  errorMessage String?  @db.Text   // 最近一次报错简述
  lastErrorLog Json?               // 详细错误回溯
  updatedAt   DateTime @updatedAt
}

// --- 现有其他模型保持不变 ---

model Doc {
  id        Int      @id @default(autoincrement())
  title     String
  content   String   @db.LongText
  summary   String?  @db.Text
  parentId  Int?
  authorId  Int
  status    Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  author    User     @relation(fields: [authorId], references: [id])
  parent    Doc?     @relation("DocTree", fields: [parentId], references: [id])
  children  Doc[]    @relation("DocTree")

  @@index([authorId], map: "Doc_authorId_fkey")
  @@index([parentId], map: "Doc_parentId_fkey")
}

model Category {
  id        Int       @id @default(autoincrement())
  name      String    @unique
  slug      String    @unique
  type      Int       @default(1) 
  order     Int       @default(0)
  articles  Article[] @relation("ArticleCategories")
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Article {
  id          Int      @id @default(autoincrement())
  title       String?  
  content     String   @db.LongText 
  jsonContent Json?    
  summary     String?  @db.Text
  coverUrl    String?
  mood        String?  
  location    String?  
  clicks      Int      @default(0)
  status      Int      @default(1) 
  
  authorId    Int
  author      User     @relation(fields: [authorId], references: [id])
  categories  Category[] @relation("ArticleCategories")
  tags        Tag[]    @relation("ArticleTags")
  media       Media[]
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([authorId])
}

model Media {
  id        Int      @id @default(autoincrement())
  fileName  String
  fileType  String   
  size      Int      
  url       String   @unique 
  path      String   
  articleId Int?     
  article   Article? @relation(fields: [articleId], references: [id], onDelete: SetNull)
  userId    Int
  user      User     @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())

  @@index([articleId])
  @@index([userId])
}

model Tag {
  id        Int        @id @default(autoincrement())
  name      String     @unique
  color     String?    
  bookmarks Bookmark[] @relation("BookmarkTags")
  articles  Article[]  @relation("ArticleTags")
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

model Bookmark {
  id          Int      @id @default(autoincrement())
  url         String   @unique
  title       String
  description String?  @db.Text
  coverUrl    String?
  userId      Int
  clicks      Int      @default(0) 
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id])
  tags        Tag[]    @relation("BookmarkTags")

  @@index([userId], map: "Bookmark_userId_fkey")
}

model Menu {
  id        Int      @id @default(autoincrement())
  name      String   
  path      String   
  icon      String?  
  i18nKey   String?  
  order     Int      @default(0) 
  status    Int      @default(1) 
  parentId  Int?     
  type      Int      @default(1) 
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  parent    Menu?    @relation("MenuTree", fields: [parentId], references: [id], onDelete: Cascade)
  children  Menu[]   @relation("MenuTree")

  @@index([parentId])
}

model AuditLog {
  id         Int      @id @default(autoincrement())
  logType    String   @default("API") 
  method     String   
  path       String   
  status     Int      
  ip         String   
  location   String?  
  duration   Int      
  userAgent  String?  @db.Text
  body       Json?    
  query      Json?    
  userId     Int?     
  createdAt  DateTime @default(now())

  @@index([logType])
  @@index([path])
  @@index([createdAt])
  @@index([userId])
}
